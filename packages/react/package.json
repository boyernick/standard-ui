{
  "name": "@boyernick/standard-ui-react",
  "version": "0.4.1",
  "description": "React components for StandardUI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@central-icons-react/round-filled-radius-2-stroke-2": "^1.1.315",
    "@central-icons-react/round-outlined-radius-2-stroke-2": "^1.1.312",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "react-day-picker": "^10.0.1",
    "recharts": "^3.10.1",
    "sugar-high": "^2.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boyernick/standard-ui.git",
    "directory": "packages/react"
  }
}
