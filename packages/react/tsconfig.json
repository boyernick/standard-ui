{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Tests import "./cn.ts" so Node's type stripping resolves them directly.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}
